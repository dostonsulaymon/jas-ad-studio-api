{
  "name": "jas-ad-studio-api",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "nest start --watch --entryFile main.api",
    "dev:worker": "nest start --watch --entryFile main.worker",
    "build": "nest build",
    "start:api": "node dist/main.api",
    "start:worker": "node dist/main.worker",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "infra:up": "docker compose -p jas-ad-studio-dev -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose -p jas-ad-studio-dev -f docker-compose.dev.yml down",
    "infra:logs": "docker compose -p jas-ad-studio-dev -f docker-compose.dev.yml logs -f",
    "openapi:generate": "nest build && node dist/openapi.js write",
    "openapi:check": "nest build && node dist/openapi.js check",
    "p1:generate": "nest build && node dist/p1-generate.js",
    "p1:smoke": "nest build && node dist/p1-smoke.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "bullmq": "^6.3.4",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.1.0",
    "nestjs-zod": "^5.5.0",
    "openai": "^7.13.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.3",
    "@swc/core": "^1.16.2",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^5.4.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "unplugin-swc": "^1.6.0",
    "vitest": "^3.2.7"
  }
}
