# Copy to .env (local development). Every variable here is validated by zod at boot —
# the app refuses to start if one is missing or malformed. See src/common/config/env.schema.ts.
#
# Never commit a filled-in copy. .env and .env.* are git-ignored (D-029).

# development | test | production
NODE_ENV=development

# Required, no default. Postgres runs on host port 5437 via `pnpm infra:up`.
DATABASE_URL=postgres://jas:jas@127.0.0.1:5437/jas_ad_studio

# Required, no default. Redis runs on host port 6384 via `pnpm infra:up`.
REDIS_URL=redis://127.0.0.1:6384

# HTTP port for the api process in development.
PORT=3040

# Optional. Defaults to debug in development, info otherwise.
# fatal | error | warn | info | debug | trace
# LOG_LEVEL=debug

# How long a single /health/ready check may take before it is reported down.
HEALTH_CHECK_TIMEOUT_MS=2000

# D-029. Optional in P0 — nothing calls a model yet, and CI boots without it. P1 makes
# the provider require it at the point of use. Doston's development key for now;
# production billing moves to Jakhongir before launch (D-004).
# OPENAI_API_KEY=

# The model the P1 harness calls. --model overrides it. Source 01 §27: never hard-code
# an unverified model name. Must be one the adapter has pricing for, or it refuses.
# OPENAI_MODEL=gpt-4.1-mini
