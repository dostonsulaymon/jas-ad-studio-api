# Copy to .env (local development). Every variable here is validated by zod at boot —
# the app refuses to start if one is missing or malformed. See src/common/config/env.schema.ts.
#
# Never commit a filled-in copy. .env and .env.* are git-ignored (D-029).

# development | test | production
NODE_ENV=development

# Required, no default. Postgres runs on host port 5437 via `pnpm infra:up`.
DATABASE_URL=postgres://jas:jas@127.0.0.1:5437/jas_ad_studio

# Required, no default. Redis runs on host port 6384 via `pnpm infra:up`.
REDIS_URL=redis://127.0.0.1:6384

# HTTP port for the api process in development.
PORT=3040

# Optional. Defaults to debug in development, info otherwise.
# fatal | error | warn | info | debug | trace
# LOG_LEVEL=debug

# How long a single /health/ready check may take before it is reported down.
HEALTH_CHECK_TIMEOUT_MS=2000

# D-029. Optional in P0 — nothing calls a model yet, and CI boots without it. P1 makes
# the provider require it at the point of use. Doston's development key for now;
# production billing moves to Jakhongir before launch (D-004).
# OPENAI_API_KEY=

# The model the P1 harness calls. --model overrides it. Source 01 §27: never hard-code
# an unverified model name. Must be one the adapter has pricing for, or it refuses.
OPENAI_MODEL=gpt-5.5

# --- Google sign-in (D-015, D-028, D-037) ---
# Dev OAuth client "jas-ad-studio-dev" lives in GCP project `jas-ad-studio`, created
# 2026-09-12 under Doston's account. The PRODUCTION client is created separately under
# Jakhongir's account at P8 (D-004) — do not reuse this one.
#
# Consent screen: External, publishing status Testing (100-user cap, Doston added as a
# test user). Scopes are openid/email/profile only, which are non-sensitive, so Google
# requires no verification review before the pilot.
#
# Registered redirect URIs (both, because Google treats them as different origins):
#   http://localhost:3040/api/auth/google/callback
#   http://127.0.0.1:3040/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3040/api/auth/google/callback

# Where a completed sign-in lands, and the ONLY origin the CSRF guard accepts on a
# state-changing request (spec §10). In P5 this becomes the web app's origin.
WEB_ORIGIN=http://localhost:3040

# D-037: Google accounts that get role `owner` at sign-in. Comma-separated.
# Everyone else is a `seller`. Owner role is never settable through the API.
OWNER_EMAILS=

# R-6: the private photo volume. Two copies per upload live here under random paths, and
# nothing in this directory is ever served by a public URL.
STORAGE_ROOT=./storage/photos

# --- Credits and orders (P3) ---
# Spec §10: a per-day ceiling on how many orders one seller can place. Abuse here costs
# Jakhongir's attention, not money — every order is confirmed by hand (D-008).
ORDERS_PER_DAY_LIMIT=5

# --- Generation pipeline (P4) ---
# Spec §10. Summed from generations.est_cost_usd, so the cap counts what was really
# spent. Deliberately low: this is the number standing between a bug and a bill.
#
# D-082, measured 2026-09-12: one real gpt-5.5 generation cost $0.359 (~4,414 som), four
# times Q-02's estimate. At 2 USD this buys FIVE generations a day for the whole app —
# a fine guard against a runaway loop, but it must be raised before the pilot (D-024).
DAILY_AI_SPEND_LIMIT_USD=2

# Source 01 §33: authenticated account-level limits, so one seller cannot spend a whole
# day's budget alone.
GENERATIONS_PER_DAY_LIMIT=20

# §29: "cap repeated free analysis attempts to prevent abuse". Counts cache MISSES only —
# answering the questions a seller was asked must never count against them.
NEEDS_INPUT_PER_PROJECT_PER_DAY=5

# How long a worker owns a job before the sweeper may take it. Longer than the slowest
# plausible provider call plus one repair; a real call measured ~60s (D-082).
JOB_LEASE_MINUTES=5

# How many generation jobs the worker process handles at once.
WORKER_CONCURRENCY=2
