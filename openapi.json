{
  "openapi": "3.0.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The process is alive."
          }
        },
        "summary": "Liveness. Always 200 while the process is running.",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Every dependency is up."
          },
          "503": {
            "description": "At least one dependency is down; the report names which."
          }
        },
        "summary": "Readiness. 503 when a dependency is unusable.",
        "tags": [
          "health"
        ]
      }
    },
    "/api/auth/google": {
      "get": {
        "description": "Redirects to Google. It cannot be driven from Swagger — the consent screen needs a real browser navigation. Once signed in, the session cookie is set on this origin and every route below works from here.",
        "operationId": "AuthController_start",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Start Google sign-in. Open this in a browser, not from this page.",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/auth/google/callback": {
      "get": {
        "description": "A missing or stale state is 400 OAUTH_STATE_INVALID; only a genuine provider failure is 502 AUTH_PROVIDER_FAILED (D-067).",
        "operationId": "AuthController_callback",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Google's redirect target. Not called directly.",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "Revoke the session immediately, server-side.",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserDto"
                }
              }
            }
          }
        },
        "summary": "The signed-in user. The role comes from OWNER_EMAILS (D-037).",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/projects": {
      "post": {
        "operationId": "ProjectsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BriefDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectSummaryDto"
                }
              }
            }
          }
        },
        "summary": "Create a project from the seller's brief.",
        "tags": [
          "Projects"
        ]
      },
      "get": {
        "operationId": "ProjectsController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProjectSummaryDto"
                  }
                }
              }
            }
          }
        },
        "summary": "The caller's own projects, newest first. Deleted ones are omitted.",
        "tags": [
          "Projects"
        ]
      }
    },
    "/api/projects/{id}": {
      "get": {
        "operationId": "ProjectsController_get",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectSummaryDto"
                }
              }
            }
          }
        },
        "summary": "One project. 404 if it is not the caller's, never 403.",
        "tags": [
          "Projects"
        ]
      },
      "patch": {
        "operationId": "ProjectsController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BriefDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectSummaryDto"
                }
              }
            }
          }
        },
        "summary": "Replace the brief. Every field is required.",
        "tags": [
          "Projects"
        ]
      },
      "delete": {
        "operationId": "ProjectsController_remove",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "Soft-delete. Its photos stop being served too (D-068).",
        "tags": [
          "Projects"
        ]
      }
    },
    "/api/projects/{projectId}/assets": {
      "post": {
        "description": "The format is decided by decoding, never by filename or content-type. Two copies are stored — a 2048px reference and a 1024px model input — with all metadata stripped. width and height describe the reference copy (D-066).",
        "operationId": "AssetsController_upload",
        "parameters": [
          {
            "name": "projectId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "photo"
                ],
                "properties": {
                  "photo": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoredAssetDto"
                }
              }
            }
          }
        },
        "summary": "Upload one product photo. At most four per project.",
        "tags": [
          "Assets"
        ]
      },
      "get": {
        "operationId": "AssetsController_list",
        "parameters": [
          {
            "name": "projectId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StoredAssetDto"
                  }
                }
              }
            }
          }
        },
        "summary": "A project's reference photos, oldest first.",
        "tags": [
          "Assets"
        ]
      }
    },
    "/api/assets/{id}/reference": {
      "get": {
        "description": "Private: never cached, and 404 once the project is deleted (D-068).",
        "operationId": "AssetsController_reference",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        },
        "summary": "Download the 2048px reference copy.",
        "tags": [
          "Assets"
        ]
      }
    },
    "/api/assets/{id}": {
      "delete": {
        "operationId": "AssetsController_remove",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "Delete a photo. Both stored copies go, and the files with them.",
        "tags": [
          "Assets"
        ]
      }
    }
  },
  "info": {
    "title": "JAS Ad Studio API",
    "description": "Ad concepts and Google Flow prompts for Uzbek sellers.",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "CurrentUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "role": {
            "type": "string",
            "enum": [
              "seller",
              "owner"
            ]
          }
        },
        "required": [
          "id",
          "email",
          "role"
        ]
      },
      "BriefDto": {
        "type": "object",
        "properties": {
          "productName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "goal": {
            "type": "string",
            "enum": [
              "awareness",
              "sales",
              "launch",
              "trust"
            ]
          },
          "formatId": {
            "type": "string",
            "enum": [
              "product-film",
              "high-energy",
              "lifestyle-story",
              "ugc-authentic"
            ]
          },
          "platform": {
            "type": "string",
            "enum": [
              "instagram",
              "telegram",
              "tiktok",
              "youtube-shorts"
            ]
          },
          "aspectRatio": {
            "type": "string",
            "enum": [
              "9:16",
              "16:9",
              "1:1"
            ]
          },
          "durationSeconds": {
            "default": 10,
            "type": "number",
            "exclusiveMinimum": true,
            "minimum": 0
          },
          "audience": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "nullable": true
          },
          "confirmedClaims": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "claim": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "verified": {
                  "type": "boolean"
                }
              },
              "required": [
                "claim",
                "verified"
              ],
              "additionalProperties": false
            }
          },
          "offer": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "priceUzs": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "nullable": true
              },
              "validUntil": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                "nullable": true
              }
            },
            "required": [
              "description",
              "priceUzs",
              "validUntil"
            ],
            "additionalProperties": false,
            "nullable": true
          },
          "galleryInspirationId": {
            "type": "string",
            "minLength": 1,
            "nullable": true
          }
        },
        "required": [
          "productName",
          "description",
          "goal",
          "formatId",
          "platform",
          "aspectRatio",
          "audience",
          "confirmedClaims",
          "offer",
          "galleryInspirationId"
        ],
        "additionalProperties": false
      },
      "ProjectSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string"
          },
          "formatId": {
            "type": "string"
          },
          "durationSeconds": {
            "type": "number"
          },
          "aspectRatio": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "name",
          "formatId",
          "durationSeconds",
          "aspectRatio",
          "createdAt"
        ]
      },
      "StoredAssetDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "projectId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "width": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "height": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "bytes": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "isPrimary": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "projectId",
          "width",
          "height",
          "bytes",
          "isPrimary"
        ]
      }
    }
  }
}
